# Vorlage für /opt/hubiplan-website/.env auf dem Testserver (ohne echte Geheimnisse)
DJANGO_SECRET_KEY=bitte-auf-dem-server-zufaellig-erzeugen
ALLOWED_HOSTS=test.example.org,website,127.0.0.1
# HUBIplan intern im Docker-Netz und öffentlich für den Browser
HUBIPLAN_API_URL=http://backend:8000
HUBIPLAN_PUBLIC_URL=https://test.example.org
HUBIPLAN_HOST=test.example.org
# Logos und Bilder (/media/…) liefert Caddy aus, intern über Port 8081 im Docker-Netz
# (die eigene öffentliche Adresse erreicht der Container nicht)
HUBIPLAN_MEDIA_URL=http://web:8081
# Testserver: Seite liegt unter /webseite und gehört zu dieser Domain aus HUBIplan
BASE_PATH=/webseite
SITE_HOST_OVERRIDE=www.sv-musterstadt.test
# Hinter HestiaCP (WEBSITE_HINTER_PROXY=1): derselbe geheime Kopfwert wie für HUBIplan, damit
# nur der nginx die Besucheradresse nennen darf (deploy/hestia/proxy-geheim.sh trägt ihn ein)
#HUBIPLAN_PROXY_GEHEIM=
# Container, die ohne Kopfwert weiterleiten dürfen (Caddy von HUBIplan)
#WEBSITE_PROXY_HOSTS=web
